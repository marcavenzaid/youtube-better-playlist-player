# Copy this file to .env and fill in your key.
#
# Optional. Without a key the player still works, but it reads playlists
# through a hidden embed: titles arrive late and playlists are capped at
# roughly 200 items.
#
# Get one at https://console.cloud.google.com/
#   1. Create a project
#   2. Enable "YouTube Data API v3"
#   3. Credentials -> Create credentials -> API key
#
# .env is gitignored. Note that the key is still handed to the page and is
# visible in browser devtools - this keeps it out of your source files, not
# out of the browser. Restrict the key to the YouTube Data API in the console.
# For more details see https://developers.google.com/youtube/v3/getting-started

YOUTUBE_API_KEY=

# Port for the local server. Optional, defaults to 8123.
PORT=8123
